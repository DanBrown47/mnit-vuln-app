<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_screen"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <TextView android:text="@string/heading"
        android:background="@drawable/bg_badge_pill" android:textColor="@color/surfaceWhite"
        android:textStyle="bold" android:textSize="12sp" android:letterSpacing="0.08"
        android:paddingHorizontal="14dp" android:paddingVertical="8dp"
        android:layout_marginTop="28dp" android:layout_marginStart="24dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView android:text="@string/send_tea"
        android:textColor="@color/surfaceWhite" android:textStyle="bold" android:textSize="30sp"
        android:layout_marginStart="24dp" android:layout_marginTop="16dp" android:layout_marginBottom="20dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginHorizontal="20dp" android:layout_marginBottom="24dp"
        app:cardCornerRadius="24dp" app:cardElevation="12dp" app:cardBackgroundColor="@color/surfaceWhite">

        <LinearLayout android:orientation="vertical" android:padding="24dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <TextView android:text="@string/sending_to"
                android:textColor="@color/textSecondary" android:textSize="12sp"
                android:textStyle="bold" android:letterSpacing="0.08"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@color/surfaceMuted"
                android:padding="12dp" android:layout_marginTop="8dp" android:layout_marginBottom="20dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">

                <TextView android:id="@+id/recipient_avatar"
                    android:background="@drawable/bg_avatar_circle"
                    android:textColor="@color/surfaceWhite" android:textStyle="bold" android:textSize="16sp"
                    android:gravity="center" android:text="?"
                    android:layout_width="40dp" android:layout_height="40dp"/>

                <TextView android:id="@+id/recipient_name"
                    android:textColor="@color/textPrimary" android:textStyle="bold" android:textSize="17sp"
                    android:layout_marginStart="12dp" android:text="…"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="@color/gradientStart"
                android:hint="@string/message_hint"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/body" android:inputType="textMultiLine" android:minLines="4"
                    android:gravity="top"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/send" android:text="@string/send_tea"
                app:cornerRadius="14dp" app:backgroundTint="@color/gradientStart"
                android:textSize="16sp" android:layout_marginTop="20dp" android:paddingVertical="10dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
