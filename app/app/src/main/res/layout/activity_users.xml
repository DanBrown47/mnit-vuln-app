<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="20dp"
    android:background="@color/paper"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="@string/heading"
        android:background="@color/ink" android:textColor="@color/paper"
        android:textStyle="bold" android:textSize="22sp" android:padding="16dp"
        android:letterSpacing="0.1"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="USERS — tap to send tea"
        android:textColor="@color/oxblood" android:textStyle="bold"
        android:layout_marginTop="16dp" android:layout_marginBottom="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/my_tea" android:text="My Tea"
        android:backgroundTint="@color/oxblood"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <ListView android:id="@+id/list" android:layout_marginTop="12dp"
        android:layout_width="match_parent" android:layout_height="match_parent"/>
</LinearLayout>
